# Copy to .env (never commit .env).

# A Tailscale auth key: https://login.tailscale.com/admin/settings/keys
# (Reusable off, ephemeral off. Only needed the first time; the machine stays logged in.)
TS_AUTHKEY=tskey-auth-...

# The machine name on your tailnet. Phones use https://<name>.<tailnet>.ts.net/
CASTLIVE_HOSTNAME=castlive
