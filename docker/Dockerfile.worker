# GPU reconstructor: COLMAP (CUDA) from the official image, plus Python for the pipeline and
# PyTorch + gsplat for the splat stage.
# Needs an NVIDIA GPU and Docker's GPU support (Docker Desktop on Windows has it built in).
# Pinned: the pipeline is checked against this COLMAP (4.2.1). Change it on purpose, then test.
FROM colmap/colmap@sha256:c1de51615dff33066cd305071226b6343c1168324ef3bd622f0825e55feb5efe AS texrecon
# mvs-texturing (BSD-3; its mve, rayint and mapmap parts BSD-3, Eigen in MPL-2-only mode),
# every source pinned. Only the texrecon program goes into the final image.
RUN apt-get update && apt-get install -y --no-install-recommends git cmake build-essential \
      ca-certificates libpng-dev libjpeg-dev libtiff-dev libtbb-dev && rm -rf /var/lib/apt/lists/*
RUN git clone https://github.com/nmoehrle/mvs-texturing /src && cd /src \
 && git checkout f3374298ac959cb5afe47a14e4d35d2ac7fbdbb1 \
 && sed -i 's/-march=native//' CMakeLists.txt \
 && sed -i 's|GIT_TAG         cuda|GIT_TAG         b62c8905f6dd11a179128517e814e0e00f9bb809|; s|GIT_REPOSITORY  https://github.com/nmoehrle/mve.git|&\n    GIT_TAG         91c0f3fde0781399b2fe872d8e52e4899274a84a|' elibs/CMakeLists.txt \
 && mkdir build && cd build && cmake -DCMAKE_BUILD_TYPE=Release .. && make -j8 texrecon

# gsplat (Apache-2.0) compiled for Blackwell (sm_120) against the same PyTorch as the final
# image; Ubuntu 24.04 / Python 3.12 like the COLMAP image, so the wheel installs there as is.
FROM nvidia/cuda:12.8.1-devel-ubuntu24.04 AS gsplat
ENV DEBIAN_FRONTEND=noninteractive TORCH_CUDA_ARCH_LIST="12.0" MAX_JOBS=8
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv python3-dev \
      git build-essential ninja-build && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/venv && /opt/venv/bin/pip install --no-cache-dir torch==2.7.1 numpy \
      --index-url https://download.pytorch.org/whl/cu128 --extra-index-url https://pypi.org/simple
RUN git clone --recursive -b v1.5.3 https://github.com/nerfstudio-project/gsplat.git /src \
 && cd /src && BUILD_NO_CUDA=0 /opt/venv/bin/pip wheel --no-build-isolation --no-deps -w /wheels .

FROM colmap/colmap@sha256:c1de51615dff33066cd305071226b6343c1168324ef3bd622f0825e55feb5efe

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python3-venv ffmpeg libgl1 libglib2.0-0 libgomp1 \
      libpng16-16t64 libjpeg-turbo8 libtiff6 libtbb12 \
 && rm -rf /var/lib/apt/lists/*

# uid 1000 owns /data in every CAST container (Ubuntu's image ships a user "ubuntu" with it)
RUN (userdel -r ubuntu 2>/dev/null || true) && useradd --create-home --uid 1000 castlive \
 && mkdir -p /data && chown castlive /data

RUN python3 -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH PYTHONUNBUFFERED=1
RUN pip install --no-cache-dir numpy scipy opencv-python-headless pillow open3d scikit-image \
      "rembg[gpu]" "onnxruntime-gpu[cuda,cudnn]"
# PyTorch with its own CUDA 12.8 libraries, and gsplat built above (the splat stage).
COPY --from=gsplat /wheels /opt/castlive/wheels
RUN pip install --no-cache-dir torch==2.7.1 --index-url https://download.pytorch.org/whl/cu128 \
      --extra-index-url https://pypi.org/simple \
 && pip install --no-cache-dir /opt/castlive/wheels/gsplat-*.whl \
 && python -c "import gsplat, skimage, torch; print(torch.__version__, gsplat.__version__)"

# COLMAP's ALIKED + LightGlue models (fetched now: the reconstructor has no network), checked
# against the hashes COLMAP itself expects.
RUN mkdir -p /opt/castlive/models && cd /opt/castlive/models \
 && base=https://github.com/colmap/colmap/releases/download/3.13.0 \
 && python -c "import urllib.request as u; [u.urlretrieve(f'$base/{n}', n) for n in ['aliked-n16rot.onnx','aliked-lightglue.onnx','bruteforce-matcher.onnx']]" \
 && printf '%s  %s\n' \
    39c423d0a6f03d39ec89d3d1d61853765c2fb6a8b8381376c703e5758778a547 aliked-n16rot.onnx \
    b9a5de7204648b18a8cf5dcac819f9d30de1a5961ef03756803c8b86c2dceb8d aliked-lightglue.onnx \
    3c1282f96d83f5ffc861a873298d08bbe5219f59af59223f5ceab5c41a182a47 bruteforce-matcher.onnx \
    | sha256sum -c -

# COLMAP's built-in ONNX Runtime (for ALIKED/LightGlue) is built for CUDA 12 and dlopens
# "libcudnn.so". The pip ONNX Runtime above (for rembg) is a CUDA 13 build with its own cuDNN,
# loaded by its own preload_dlls(). Mixing the two failed ("CUDA failure 999"), so COLMAP gets
# a separate cuDNN for CUDA 12, placed after the image's own CUDA 12 libraries.
RUN pip install --no-cache-dir --target /opt/castlive/cudnn12 "nvidia-cudnn-cu12>=9,<10" \
 && mkdir -p /opt/castlive/cudalibs && for so in /opt/castlive/cudnn12/nvidia/cudnn/lib/*.so*; do \
      n=$(basename "$so"); ln -sf "$so" "/opt/castlive/cudalibs/$n"; ln -sf "$so" "/opt/castlive/cudalibs/${n%%.so*}.so"; done
ENV LD_LIBRARY_PATH=${LD_LIBRARY_PATH}:/opt/castlive/cudalibs

# The masking model is fetched now, so the worker never needs the internet
USER castlive
RUN python -c "from rembg import new_session; new_session('birefnet-general-lite', providers=['CPUExecutionProvider'])"
USER root

COPY --from=texrecon /src/build/apps/texrecon/texrecon /usr/local/bin/texrecon

WORKDIR /app
# Settings first, code last: a code change then rebuilds only the last layers (the classic
# builder takes minutes per step on these large images).
RUN pip install --no-cache-dir fastapi uvicorn segno
ENV CASTLIVE_DATA=/data CASTLIVE_WEB=/app/web
CMD ["castlive-worker", "--reconstruct"]
COPY pyproject.toml ./
COPY castlive ./castlive
COPY web ./web
RUN pip install --no-cache-dir --no-deps .
USER castlive
